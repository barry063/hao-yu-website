{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Reviewed public content v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "release_date",
    "sources",
    "profile",
    "qualification_events",
    "links",
    "outputs",
    "experience",
    "qualifications",
    "awards",
    "narratives",
    "presentation"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "release_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9-]*$"
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "id",
          "path",
          "sha256"
        ],
        "additionalProperties": false
      }
    },
    "profile": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9-]*$"
        },
        "selected": {
          "type": "boolean"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "institution": {
          "type": "string",
          "minLength": 1
        },
        "institution_short": {
          "type": "string",
          "minLength": 1
        },
        "discipline": {
          "type": "string",
          "minLength": 1
        },
        "group": {
          "type": "string",
          "minLength": 1
        },
        "email": {
          "type": "string",
          "minLength": 1
        },
        "location": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "selected",
        "provenance",
        "name",
        "role",
        "institution",
        "institution_short",
        "discipline",
        "group",
        "email",
        "location"
      ],
      "additionalProperties": false
    },
    "qualification_events": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9-]*$"
          },
          "selected": {
            "type": "boolean"
          },
          "provenance": {
            "$ref": "#/$defs/provenance"
          },
          "qualification_id": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9-]*$"
          },
          "kind": {
            "enum": [
              "THESIS_SUBMITTED",
              "VIVA_COMPLETED",
              "DEGREE_AWARDED"
            ]
          },
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          }
        },
        "required": [
          "id",
          "selected",
          "provenance",
          "qualification_id",
          "kind",
          "date"
        ],
        "additionalProperties": false
      }
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9-]*$"
          },
          "selected": {
            "type": "boolean"
          },
          "provenance": {
            "$ref": "#/$defs/provenance"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "selected",
          "provenance",
          "label",
          "url"
        ],
        "additionalProperties": false
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9-]*$"
          },
          "selected": {
            "type": "boolean"
          },
          "provenance": {
            "$ref": "#/$defs/provenance"
          },
          "kind": {
            "enum": [
              "ARTICLE",
              "SOFTWARE"
            ]
          },
          "status": {
            "enum": [
              "PUBLISHED",
              "ACCEPTED",
              "SUBMITTED",
              "UNDER_REVIEW",
              "IN_PREPARATION",
              "RESEARCH_SOFTWARE"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "year": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1900,
            "maximum": 2200
          },
          "authors": {
            "type": [
              "string",
              "null"
            ]
          },
          "venue": {
            "type": [
              "string",
              "null"
            ]
          },
          "contribution": {
            "type": "string",
            "minLength": 1
          },
          "links": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "label": {
                  "type": "string",
                  "minLength": 1
                },
                "url": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "label",
                "url"
              ],
              "additionalProperties": false
            }
          },
          "cv_authors": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "selected",
          "provenance",
          "kind",
          "status",
          "title",
          "year",
          "authors",
          "venue",
          "contribution",
          "links",
          "cv_authors"
        ],
        "additionalProperties": false
      }
    },
    "experience": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9-]*$"
          },
          "selected": {
            "type": "boolean"
          },
          "provenance": {
            "$ref": "#/$defs/provenance"
          },
          "text": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "organisation": {
            "type": "string",
            "minLength": 1
          },
          "start_month": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}$"
          },
          "end_month": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}$"
          }
        },
        "required": [
          "id",
          "selected",
          "provenance",
          "text",
          "role",
          "organisation",
          "start_month",
          "end_month"
        ],
        "additionalProperties": false
      }
    },
    "qualifications": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9-]*$"
          },
          "selected": {
            "type": "boolean"
          },
          "provenance": {
            "$ref": "#/$defs/provenance"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "dates": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "id",
          "selected",
          "provenance",
          "title",
          "dates",
          "text"
        ],
        "additionalProperties": false
      }
    },
    "awards": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9-]*$"
          },
          "selected": {
            "type": "boolean"
          },
          "provenance": {
            "$ref": "#/$defs/provenance"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "dates": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "selected",
          "provenance",
          "title",
          "dates"
        ],
        "additionalProperties": false
      }
    },
    "narratives": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9-]*$"
          },
          "selected": {
            "type": "boolean"
          },
          "provenance": {
            "$ref": "#/$defs/provenance"
          },
          "destination": {
            "enum": [
              "top",
              "about",
              "research",
              "projects"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "dates": {
            "type": "string"
          },
          "text": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "links": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "label": {
                  "type": "string",
                  "minLength": 1
                },
                "output_link_index": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "label",
                "output_link_index"
              ],
              "additionalProperties": false
            }
          },
          "output_id": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "selected",
          "provenance",
          "destination",
          "title",
          "dates",
          "text",
          "links",
          "output_id"
        ],
        "additionalProperties": false
      }
    },
    "presentation": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "minLength": 1
        },
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "cv": {
          "const": "assets/Hao_Yu_CV.pdf"
        },
        "portrait": {
          "const": "assets/hao-yu-portrait.jpg"
        },
        "social": {
          "type": "object",
          "properties": {
            "topic": {
              "type": "string",
              "minLength": 1
            },
            "alt": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "topic",
            "alt"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "url",
        "repository",
        "title",
        "description",
        "cv",
        "portrait",
        "social"
      ],
      "additionalProperties": false
    }
  },
  "$defs": {
    "provenance": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "evidence_status": {
          "enum": [
            "VERIFIED",
            "APPLICANT_CONFIRMED"
          ]
        },
        "visibility": {
          "const": "PUBLIC"
        },
        "reviewed": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      },
      "required": [
        "source",
        "evidence_status",
        "visibility",
        "reviewed"
      ],
      "additionalProperties": false
    }
  }
}
